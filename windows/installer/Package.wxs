<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="sb-easy" Manufacturer="sb-easy" Version="$(Version)"
           UpgradeCode="78E985E7-0CDC-4782-B1EA-52DCE6B3E544"
           Scope="perMachine" InstallerVersion="500" Language="1033">
    <SummaryInformation Description="sb-easy background service and local web management tray" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of sb-easy is already installed."
                  Schedule="afterInstallInitialize" />
    <CustomAction Id="RemoveLeakProtection" FileRef="ServiceExe" ExeCommand="--disable-kill-switch"
                  Execute="deferred" Impersonate="no" Return="check" />
    <Property Id="SB_EASY_UPDATE" Secure="yes" />
    <CustomAction Id="VerifyUpgradeHealth" FileRef="ServiceExe" ExeCommand="--upgrade-health-check"
                  Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="RemoveLeakProtection" Before="DeleteServices"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="VerifyUpgradeHealth" After="StartServices"
              Condition="SB_EASY_UPDATE=&quot;1&quot; AND NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="SbEasyIcon" SourceFile="$(Payload)\sb-easy.ico" />
    <Property Id="ARPPRODUCTICON" Value="SbEasyIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/cloudy064/sb-easy" />
    <Property Id="WINDOWS_BUILD">
      <RegistrySearch Id="WindowsBuild" Root="HKLM" Bitness="always64"
        Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" />
    </Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWS_BUILD &gt;= 10240)"
      Message="sb-easy requires 64-bit Windows 10 or later." />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="sb-easy">
        <!-- Repair the public application root on upgrades from versions whose
             private plugin store incorrectly restricted its parent directory.
             Protected private stores retain their own separate DACL. -->
        <Component Id="ApplicationDirectoryAccess" Guid="9C0E777A-E222-43F1-90B6-C4AA593C80DF">
          <CreateFolder>
            <PermissionEx Id="ApplicationReadExecute" Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
          </CreateFolder>
        </Component>
        <!-- Retain the component/file identity for upgrades from the old GUI. -->
        <Component Id="DesktopExecutable" Guid="*">
          <File Id="DesktopExe" Source="$(Payload)\sb-easy.exe" KeyPath="yes">
            <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="sb-easy"
                      Advertise="yes" Icon="SbEasyIcon" IconIndex="0" WorkingDirectory="INSTALLFOLDER" />
          </File>
        </Component>
        <Component Id="TrayAutoStart" Guid="*">
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run"
            Name="sb-easy" Type="string" Value="&quot;[INSTALLFOLDER]sb-easy.exe&quot; --background" KeyPath="yes" />
        </Component>
        <Component Id="ServiceExecutable" Guid="*">
          <File Id="ServiceExe" Source="$(Payload)\sb-easy-service.exe" KeyPath="yes" />
          <ServiceInstall Id="BackgroundService" Name="sb-easy" DisplayName="sb-easy"
            Description="Manages sb-easy configuration and the sing-box connection."
            Type="ownProcess" Start="auto" Account="LocalSystem" ErrorControl="normal" Vital="yes" />
          <ServiceControl Id="BackgroundServiceControl" Name="sb-easy"
                          Stop="both" Start="install" Remove="uninstall" Wait="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <Feature Id="Complete" Title="sb-easy" Level="1">
      <ComponentRef Id="ApplicationDirectoryAccess" />
      <ComponentRef Id="DesktopExecutable" />
      <ComponentRef Id="TrayAutoStart" />
      <ComponentRef Id="ServiceExecutable" />
      <Files Directory="INSTALLFOLDER" Include="$(Payload)\**">
        <Exclude Files="$(Payload)\sb-easy.exe" />
        <Exclude Files="$(Payload)\sb-easy-service.exe" />
      </Files>
    </Feature>
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)PreviewNotice.rtf" />
  </Package>
</Wix>
