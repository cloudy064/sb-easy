# Keep the build context small — these are rebuilt inside the image or unneeded.
target/
build/
dist/
bin/
frontend/node_modules/
frontend/dist/
agent-ui/node_modules/
agent-ui/dist/
data/
.git/
*.db
*.db-*
**/*.tsbuildinfo
.env

# Local experiments and runtime credentials are never image inputs.
tmp/
agent-data/
backups/
**/__pycache__/

# Native client outputs are unrelated to the server/agent image.
android/.gradle/
android/**/build/
android/.kotlin/
windows/ui/node_modules/
windows/ui/dist/
extensions/http-debug/.venv/
downloads/
updates/
