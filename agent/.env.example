# Managed-node config for `sb-easy agent`
#
# A managed node runs the SAME sb-easy binary in agent mode:
#     sb-easy agent
# It connects to the panel, pulls this host's config, and supervises sing-box
# in process (spawn / reload / respawn) — only one thing to run on the node.
# (The standalone `sb-easy-agent` binary is deprecated; prefer `sb-easy agent`.)

# URL of the sb-easy panel/server.
SB_EASY_SERVER=http://panel.example.com:51821

# This host's per-host agent token. Panel → Hosts → <host> → Install.
AGENT_TOKEN=

# sing-box binary this node supervises, and where its config is written.
SINGBOX_BIN=sing-box
SINGBOX_CONFIG_PATH=data/sing-box.gen.json

# Use this machine's own network for proxy-node connections. Enabled by default;
# set false only when proxy outbounds should deliberately detour via wg-internal.
SINGBOX_LOCAL_PROXY_EGRESS=true

# Optional JSON object mapping outbound tags to node entry hostnames or IPs.
# Reapplied whenever the panel profile changes.
SINGBOX_OUTBOUND_SERVER_OVERRIDES={}

# Optional JSON file mapping existing outbound tags to complete replacements.
# A replacement tag is honored and references are rewritten across the profile.
# Useful for machine-local subscription nodes; keep credentials out of Git.
SINGBOX_OUTBOUND_OVERRIDE_FILE=

# Optional default member of the route's final selector (usually Proxy).
SINGBOX_DEFAULT_PROXY_OUTBOUND=

# How often (seconds) to poll the panel for config/commands. Min 2. Default 10.
AGENT_INTERVAL=10

# Optional local Svelte console. The C++ Agent serves this external directory;
# no UI assets are compiled into the service executable.
AGENT_UI_ENABLED=true
AGENT_UI_BIND=0.0.0.0:51822
AGENT_UI_USERNAME=admin
AGENT_UI_PASSWORD=
AGENT_UI_PATH=/usr/share/sb-easy/agent-ui

# Logging
RUST_LOG=info
