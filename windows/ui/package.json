    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": { "vue": "3.5.38" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "5.2.4",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vue-tsc": "2.2.12"
  }
}
